  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.9",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web": "^0.0.294",
    "baseline-browser-mapping": "^2.9.19",
