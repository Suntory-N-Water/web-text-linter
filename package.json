{
  "name": "web-text-linter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "lint": "biome check",
    "lint:ai": "set -o pipefail && biome check . --reporter=github 2>&1 | { grep '^::' || true; }",
    "test": "AGENT=1 bun test --bail=2",
    "type-check": "tsc --noEmit",
    "type-check:ai": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
